{
  "name": "cc-medical-inventory",
  "version": "1.0.0",
  "private": true,
  "description": "CC Medical inventory, product history and CRM tool set (Cloudflare Worker + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute cc-inventory --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute cc-inventory --local --file=schema.sql",
    "db:backup": "wrangler d1 export cc-inventory --remote --output=backup.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
